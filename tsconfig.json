{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // The engine is resolved from the sibling package's SOURCE, not from its
    // `dist/`. A typecheck that reads a sibling's last build instead of its
    // working tree is the stale-dist trap one package further out; the built
    // artifact gets its turn in `npm run check:dist`.
    "paths": {
      "@ozjsey/write-behind": ["../write-behind/writeBehind.ts"]
    },
    "lib": ["ES2020", "DOM"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    // No `rootDir`: the engine's source sits in a sibling folder, which a root
    // of "." would reject. tsup owns where the build output lands anyway.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "inlineSources": true
  },
  "include": ["vueWriteBehind.ts"]
}
