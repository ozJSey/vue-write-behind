{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // No `paths` for `@ozjsey/write-behind`, deliberately. It is resolved from
    // `node_modules` — the version and integrity hash in `package-lock.json` —
    // exactly as `vitest.workspace.ts` resolves it and as a consumer does.
    //
    // This used to map the specifier to `../write-behind/writeBehind.ts`, a
    // path outside this repo. TypeScript does not fail when a `paths` target is
    // missing; it falls through to node resolution without a word. So the one
    // command `npm run typecheck` checked the sibling working tree on this
    // machine and the installed tarball's `.d.ts` on any other, with nothing in
    // the output to say which. One source of truth, and it is the published one.
    "lib": ["ES2020", "DOM"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "inlineSources": true
  },
  "include": ["vueWriteBehind.ts"]
}
